# ---------- 依赖 ----------
node_modules/

# ---------- 编译产物（由 src/ + tsc 生成）----------
dist/

# ---------- 打包产物（由 electron-builder 生成）----------
release/

# ---------- 工具链的中间产物（全部可由 tools/*.js 重新生成）----------
# 抽帧 / 抠底 / 拼图检查图 / 解压出来的 Electron 43（单这一项就 235MB）
tools/work/
# 样张（由 tools/samples.js 生成）
tools/out/

# ---------- 美术创作过程的原始素材（不进仓库；成品已落在 themes/<id>/assets/）----------
素材/
线稿/

# ---------- 实机验证脚本与产物（本地调试用，不进仓库）----------
.verify/

# ---------- 运行时/工具留下的状态 ----------
.zcode/

# ---------- Superdesign 的中间文件（提示词 / 截图 / 临时 HTML）----------
# init/、design-system.md、resume.json 是设计上下文，要进仓库；tmp/ 不是
.superdesign/tmp/

# ---------- 动态立绘视频（体积大，不进仓库；由 tools/optimize-motion.js 从帧序列生成）----------
themes/*/assets/*.webm
themes/*/assets/*.webm.json

# ---------- 杂项 ----------
*.log
*.tmp
Thumbs.db
.DS_Store
